{
  "name": "@veripack/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate-cli.ts",
    "migrate:dist": "node dist/migrate-cli.js",
    "backup": "node dist/ops/backup-cli.js backup",
    "backup:restore-check": "node dist/ops/backup-cli.js restore-check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@veripack/shared": "workspace:*",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
