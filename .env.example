# ---------------------------------------------------------------------------
# Local development defaults. Copy to .env and change anything you need.
# ---------------------------------------------------------------------------

# Postgres
DATABASE_URL=postgres://veripack:veripack@localhost:5432/veripack
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Restricted application role for evidence grants (migration 007). Leave empty
# for local development; production must set this and connect the gateway as it.
EVIDENCE_APP_ROLE=

# S3-compatible object storage. Local dev uses S3Mock on port 9090.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=veripack-tarballs
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Verdaccio (private network in production; localhost only in dev)
VERDACCIO_URL=http://localhost:4873
VERDACCIO_USER=gateway
VERDACCIO_PASSWORD=dev-service-token

# Public URL the gateway exposes to npm clients
PUBLIC_REGISTRY_URL=http://localhost:4874

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4874
PROCESS_ROLE=all
ORG_ID=dev-org
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT_BYTES=52428800
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_BACKEND=memory
PROXY_TIMEOUT_MS=60000
METRICS_ENABLED=true
METRICS_TOKEN=

# Auth. Static tokens are for local development only. Production requires
# AUTH_MODE=oidc, github, or hybrid.
AUTH_MODE=static
VERIPACK_TOKEN=dev-token
READ_TOKEN=
REVIEWER_TOKEN=
ADMIN_TOKEN=admin-token
DEFAULT_PUBLISHER=dev-publisher
REVIEWER_USER=dev-reviewer
ADMIN_USER=dev-admin
ALLOW_SELF_APPROVAL=false
ALLOW_UNSCOPED_NAMES=false
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
OIDC_ORG_CLAIM=org_id
OIDC_PACKAGE_CLAIM=package_scope
OIDC_READ_SCOPE_CLAIM=read_scope
OIDC_PUBLISH_SCOPE_CLAIM=publish_scope
OIDC_PUBLISHER_ROLES=publisher
OIDC_REVIEWER_ROLES=reviewer
OIDC_ADMIN_ROLES=admin
OIDC_REQUIRE_PACKAGE_SCOPE=false
OIDC_CLOCK_TOLERANCE_SECONDS=5

# GitHub federation. Actions exchange their short-lived OIDC token for a
# short-lived Veripack bearer token. Dashboard OAuth can use the same exchange.
GITHUB_OIDC_ENABLED=false
GITHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com
GITHUB_OIDC_JWKS_URL=https://token.actions.githubusercontent.com/.well-known/jwks
GITHUB_OIDC_AUDIENCE=veripack
GITHUB_ALLOWED_REPOSITORIES=owner/repository
GITHUB_ALLOWED_WORKFLOW_REFS=refs/heads/main
GITHUB_ADMIN_WORKFLOW_REFS=owner/repository/.github/workflows/admin-release.yml@refs/heads/main
GITHUB_PACKAGE_SCOPE=@team/*
GITHUB_PACKAGE_SCOPES={"owner/repository":{"read":["@team/*"],"publish":["@team/*"]}}
GITHUB_PROTECTED_BRANCHES=main
GITHUB_ADMIN_REPOSITORIES=
GITHUB_REVIEWER_REPOSITORIES=
GITHUB_ADMIN_USERS=
GITHUB_PUBLISHER_USERS=
GITHUB_REVIEWER_USERS=
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN_EXCHANGE_SECRET=
GITHUB_TOKEN_TTL_SECONDS=900

# Audit
AUDIT_ENGINE_VERSION=0.2.0-static
AUDIT_RULESET_VERSION=v1
AUDIT_INTEL_VERSION=v1
UPSTREAM_AUDIT_TTL_DAYS=7
UPSTREAM_SPOOL_DIR=
INGEST_PER_USER_CONCURRENCY=2
INGEST_GLOBAL_CONCURRENCY=8
INGEST_PER_USER_RATE_PER_HOUR=20
INGEST_MAX_TARBALL_BYTES=26214400
INGEST_QUOTA_BYTES_PER_HOUR=524288000
INGEST_TIMEOUT_MS=120000
AUDIT_POLICY_VERSION=m2-default-1
AUDIT_POLICY_JSON={}
AUDIT_LLM_BACKEND=disabled
# Set AUDIT_LLM_BACKEND=openai-compatible only after configuring these values.
AUDIT_LLM_URL=
AUDIT_LLM_API_KEY=
AUDIT_LLM_MODEL=
AUDIT_LLM_TIMEOUT_MS=20000
AUDIT_LLM_TEMPERATURE=0
AUDIT_LLM_MAX_TOKENS=1200
AUDIT_QUEUE=veripack-audit
AUDIT_JOB_RETRY_LIMIT=3
AUDIT_JOB_RETRY_DELAY_SECONDS=2
AUDIT_JOB_EXPIRE_SECONDS=300
AUDIT_JOB_DELETE_AFTER_SECONDS=86400
QUEUE_MAX_CONNECTIONS=5
AUDIT_OUTBOX_BATCH_SIZE=100
AUDIT_OUTBOX_INTERVAL_MS=5000
AUDIT_WORKER_REQUIRED=false
AUDIT_WORKER_HEARTBEAT_INTERVAL_MS=10000
AUDIT_WORKER_STALE_MS=60000

# Dynamic review is opt-in and executes only inside a network-disabled,
# capability-dropped container. Static analysis never invokes this path.
SANDBOX_MODE=disabled
SANDBOX_ENABLE_ON_AUDIT=false
SANDBOX_IMAGE=node@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1
SANDBOX_MAX_OUTPUT_BYTES=64000
BACKUP_S3_PREFIX=backups
# Set only for an explicit restore drill against a disposable scratch DB.
RESTORE_DATABASE_URL=

# Dashboard. OIDC is required when the web app runs in production.
GATEWAY_URL=http://localhost:4874
DASHBOARD_AUTH_MODE=static
DASHBOARD_AUTH_PROVIDER=generic
DASHBOARD_ACCESS_TOKEN=admin-token
SANDBOX_UI_ENABLED=false
SESSION_SECRET=replace-with-a-long-random-secret
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPES=openid profile email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
